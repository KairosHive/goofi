@@ -34,0 +35,27 @@ from optimum.quanto.models.shared_dict import ShardedStateDict
+def load_checkpoint(path, device):
+    """Read one tensor at a time without memory-mapped PyTorch storage."""
+    state_dict = {}
+    with safe_open(path, framework="pt", device="cpu", backend="pread") as checkpoint:
+        for key in checkpoint.keys():
+            tensor = checkpoint.get_tensor(key)
+            state_dict[key] = tensor.to(device=device,
+                dtype=torch.bfloat16 if tensor.is_floating_point() else tensor.dtype)
+    return state_dict
+
+
+def load_quantized_weights(model, state_dict, qmap):
+    """Assign checkpoint tensors without allocating full-size float placeholders."""
+    for name, config in qmap.items():
+        quantize(model, weights=None if config['weights'] == 'none' else config['weights'],
+                 activations=None if config['activations'] == 'none' else config['activations'],
+                 include=[name])
+    result = model.load_state_dict(state_dict, strict=False, assign=True)
+    expected_missing = {name + '.weight' for name, config in qmap.items()
+                        if config['weights'] != 'none'}
+    missing = set(result.missing_keys) - expected_missing
+    if missing or result.unexpected_keys:
+        raise ValueError(f'Invalid quantized checkpoint: missing={missing}, unexpected={result.unexpected_keys}')
+    if any(p.device.type == 'meta' for p in model.parameters()):
+        raise ValueError('Quantized checkpoint left unassigned model parameters')
+
